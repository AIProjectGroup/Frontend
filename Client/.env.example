# Environment Variables for Vercel Deployment
# Copy this file to .env.local for local development
# Add these variables to your Vercel project settings

# Backend API Configuration (Optional - currently using placeholder data)
BACKEND_URL=https://your-backend-url.com

# Authentication Key for API communication (Optional)
AUTH_KEY=your-super-secret-jwt-key-for-production

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=https://your-vercel-app.vercel.app

# Google OAuth (Optional)
NEXT_PUBLIC_FRONTEND_GOOGLE_CLIENT_ID=your_google_client_id

# Stripe Configuration (Optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Domain Configuration
NEXT_PUBLIC_DOMAIN=your-vercel-app.vercel.app